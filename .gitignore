# ==========================================
# 共通設定・AI設定・エディタ設定
# ==========================================
!CLAUDE.md
!GEMINI.md
!.gitignore
!.agents/
!.agents/**
!.vscode/
!.vscode/**

# ==========================================
# 同期対象のファイル（ソースコード・Webアプリ・ドキュメント）
# ==========================================
!*.md
!*.html
!*.css
!*.js
!*.py
!*.json
!*.yaml
!*.yml
!*.txt
!*.sh
!*.bat

# フォルダ構造を追跡できるようにする
!*/

# ==========================================
# 除外対象（機密実データ・一時ファイル・仮想環境・キャッシュ）
# ==========================================
# Officeファイル・実データ・PDF・ショートカット
*.xlsx
*.xls
*.xlsm
*.pdf
*.lnk
*.docx
*.doc
~$*

# Python仮想環境・キャッシュ
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Node / Webビルド
node_modules/
dist/
build/

# OS生成ファイル・ログ
.DS_Store
Thumbs.db
*.log
.env
